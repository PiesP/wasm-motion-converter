{
  "name": "wasm-motion-converter",
  "version": "0.1.2",
  "license": "MIT",
  "author": "PiesP",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.2.2"
  },
  "volta": {
    "node": "26.5.0",
    "pnpm": "11.2.2"
  },
  "scripts": {
    "preinstall": "test -f packages/core/package.json || { echo '⚠️  Submodule not initialized. Run: git submodule update --init'; exit 1; }",
    "dev": "NODE_OPTIONS=\"--no-deprecation\" vite",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "fmt": "biome check --linter-enabled=false .",
    "fmt:fix": "biome check --write --linter-enabled=false .",
    "fmt:check": "pnpm -s fmt",
    "check": "tsc -p tsconfig.json --noEmit",
    "typecheck": "pnpm -s check",
    "knip": "knip --dependencies",
    "circular": "pnpm dlx madge --ts-config tsconfig.json --circular src/**/*.ts",
    "knip:full": "knip --files --exports --dependencies --reporter compact --max-show-issues 50 --no-exit-code",
    "prebuild": "npx tsx scripts/generate-licenses.ts && pnpm -s quality",
    "build": "NODE_OPTIONS=\"--no-deprecation\" vite build",
    "build:ci": "npx tsx scripts/generate-licenses.ts && NODE_OPTIONS=\"--no-deprecation\" vite build && npx tsx scripts/postbuild.ts",
    "postbuild": "npx tsx scripts/postbuild.ts",
    "analyze": "NODE_OPTIONS=\"--no-deprecation\" VITE_ANALYZE_BUNDLE=true vite build && node -e \"console.log('\\\\nBundle analysis generated at dist/stats.html')\"",
    "preview": "NODE_OPTIONS=\"--no-deprecation\" vite preview",
    "clean": "rm -rf dist node_modules/.vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "quality": "pnpm -s fmt && pnpm -s lint && pnpm -s check && pnpm -s circular && pnpm -s knip && pnpm -s quality:nose",
    "quality:fix": "pnpm -s fmt:fix && pnpm -s lint:fix && pnpm -s check && pnpm -s circular && pnpm -s knip",
    "quality:ci": "pnpm -s fmt && pnpm -s lint && pnpm -s check && pnpm -s circular && pnpm -s knip && pnpm -s quality:nose",
    "quality:nose": "bash -c 'if command -v nose &>/dev/null; then nose query src --baseline .nose-baseline.json --fail-on new; else echo \"[nose] not installed — skipping\"; fi'",
    "verify": "pnpm -s quality && pnpm -s build:ci",
    "mut": "npx stryker run --reporters=progress",
    "mut:fast": "npx stryker run --reporters=progress --mutators=boolean,arithmetic,conditional-boundary,equality-operator,negate-conditional,string",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@piesp/browser-core": "file:packages/core",
    "gifenc": "^1.0.3",
    "mediabunny": "^1.50.8",
    "solid-js": "1.9.14",
    "wasm-webp": "^0.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@playwright/test": "^1.61.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/vite": "4.3.2",
    "@types/dom-webcodecs": "^0.1.18",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "0.28.1",
    "jsdom": "^29.1.1",
    "knip": "^6.27.0",
    "rollup-plugin-visualizer": "7.0.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "8.1.5",
    "vite-plugin-solid": "2.11.12",
    "vitest": "^4.1.10"
  }
}
