{
  "name": "wasm-motion-converter",
  "version": "0.2.1",
  "description": "Convert videos to animated GIF or WebP entirely in the browser.",
  "homepage": "https://wasm-motion-converter.pages.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PiesP/wasm-motion-converter.git"
  },
  "bugs": {
    "url": "https://github.com/PiesP/wasm-motion-converter/issues"
  },
  "license": "MIT",
  "author": "PiesP",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.17.0"
  },
  "volta": {
    "node": "26.8.1",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "preinstall": "test -f packages/core/package.json || { echo '⚠️  Submodule not initialized. Run: git submodule update --init'; exit 1; }",
    "dev": "NODE_OPTIONS=\"--no-deprecation\" vite",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "fmt": "biome check --linter-enabled=false .",
    "fmt:fix": "biome check --write --linter-enabled=false .",
    "fmt:check": "pnpm -s fmt",
    "check": "tsc -p tsconfig.json --noEmit",
    "typecheck": "pnpm -s check",
    "knip": "knip --dependencies",
    "circular": "dpdm --tsconfig tsconfig.json --circular --no-tree --no-warning --exit-code circular:1 src/**/*.ts",
    "knip:full": "knip --files --exports --dependencies --reporter compact --max-show-issues 50 --no-exit-code",
    "prebuild": "node --experimental-strip-types scripts/build/generate-licenses.ts && pnpm -s quality",
    "build": "NODE_OPTIONS=\"--no-deprecation\" vite build",
    "build:ci": "node --experimental-strip-types scripts/build/generate-licenses.ts && NODE_OPTIONS=\"--no-deprecation\" vite build && node --experimental-strip-types scripts/build/postbuild.ts",
    "postbuild": "node --experimental-strip-types scripts/build/postbuild.ts",
    "analyze": "NODE_OPTIONS=\"--no-deprecation\" VITE_ANALYZE_BUNDLE=true vite build && node -e \"console.log('\\\\nBundle analysis generated at dist/stats.html')\"",
    "preview": "NODE_OPTIONS=\"--no-deprecation\" vite preview",
    "clean": "node --experimental-strip-types scripts/build/clean.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare:e2e:fixture": "node --experimental-strip-types scripts/test/generate-e2e-video.ts",
    "pretest:e2e:ci": "pnpm prepare:e2e:fixture",
    "test:e2e:ci": "PLAYWRIGHT_TEST_PROFILE=ci playwright test",
    "pretest:e2e:resource": "PREPARE_RESOURCE_FIXTURES=true pnpm prepare:e2e:fixture",
    "test:e2e:resource": "PLAYWRIGHT_TEST_PROFILE=resource playwright test",
    "pretest:e2e:deploy": "pnpm prepare:e2e:fixture",
    "test:e2e:deploy": "PLAYWRIGHT_TEST_PROFILE=deploy playwright test",
    "quality": "pnpm -s fmt && pnpm -s lint && pnpm -s check && pnpm -s check:i18n && pnpm -s circular && pnpm -s knip && pnpm -s quality:nose",
    "quality:fix": "pnpm -s fmt:fix && pnpm -s lint:fix && pnpm -s quality",
    "quality:nose": "bash -c 'if command -v nose &>/dev/null; then nose query src --baseline .nose-baseline.json --fail-on new; else echo \"[nose] not installed — skipping\"; fi'",
    "verify": "pnpm -s quality && pnpm -s build:ci",
    "verify:full": "pnpm verify && pnpm test:cov && node --experimental-strip-types scripts/test/run-e2e-on-free-port.ts",
    "mut": "stryker run --reporters=progress",
    "mut:fast": "stryker run stryker.conf.fast.json",
    "release:prepare": "node --experimental-strip-types scripts/release/prepare.ts",
    "security:codex:branch": "scripts/security/codex-security.sh branch",
    "security:codex:dry-run": "scripts/security/codex-security.sh dry-run",
    "security:codex:full": "scripts/security/codex-security.sh full",
    "security:codex:working-tree": "scripts/security/codex-security.sh working-tree",
    "test:cov": "vitest run --coverage",
    "check:i18n": "node --experimental-strip-types scripts/check/i18n.ts"
  },
  "dependencies": {
    "@piesp/browser-core": "file:packages/core",
    "gifenc": "^1.0.3",
    "mediabunny": "^1.55.5",
    "solid-js": "1.9.15",
    "wasm-webp": "^0.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.11",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/dom-webcodecs": "^0.1.19",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dpdm": "4.3.0",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "rollup-plugin-visualizer": "7.1.1",
    "typescript": "^7.0.2",
    "vite": "8.2.2",
    "vite-plugin-solid": "2.11.14",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
