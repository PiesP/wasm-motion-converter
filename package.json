{
  "name": "wasm-motion-converter",
  "version": "0.2.2",
  "description": "Convert videos to animated GIF or WebP entirely in the browser.",
  "homepage": "https://wasm-motion-converter.pages.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PiesP/wasm-motion-converter.git"
  },
  "bugs": {
    "url": "https://github.com/PiesP/wasm-motion-converter/issues"
  },
  "license": "MIT",
  "author": "PiesP",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=11.26.0"
  },
  "volta": {
    "node": "26.9.0",
    "pnpm": "11.26.0"
  },
  "scripts": {
    "preinstall": "node --experimental-strip-types scripts/check/bootstrap.ts",
    "dev": "node --experimental-strip-types scripts/build/run-vite.ts dev",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "fmt": "biome check --linter-enabled=false .",
    "fmt:fix": "biome check --write --linter-enabled=false .",
    "fmt:check": "pnpm -s fmt",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:test:unit": "tsc -p tsconfig.test.json --noEmit",
    "check:test:e2e": "tsc -p test/tsconfig.playwright.json --noEmit",
    "check:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "typecheck": "pnpm -s check",
    "knip": "knip --files --exports --dependencies --treat-config-hints-as-errors",
    "knip:production": "knip --production --files --exports --dependencies --treat-config-hints-as-errors",
    "circular": "dpdm --tsconfig tsconfig.json --circular --no-tree --no-warning --exit-code circular:1 src/**/*.ts",
    "knip:full": "pnpm -s knip",
    "prebuild": "node --experimental-strip-types scripts/build/generate-licenses.ts && pnpm -s quality",
    "build": "node --experimental-strip-types scripts/build/run-vite.ts build",
    "build:ci": "node --experimental-strip-types scripts/build/run-vite.ts ci",
    "postbuild": "node --experimental-strip-types scripts/build/postbuild.ts",
    "analyze": "node --experimental-strip-types scripts/build/run-vite.ts analyze",
    "preview": "node --experimental-strip-types scripts/build/run-vite.ts preview",
    "clean": "node --experimental-strip-types scripts/build/clean.ts",
    "test": "vitest run",
    "test:ci": "node --experimental-strip-types --test scripts/ci/deep-check-reuse.test.ts scripts/check/run-child.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare:e2e:fixture": "node --experimental-strip-types scripts/test/generate-e2e-video.ts",
    "pretest:e2e:ci": "pnpm prepare:e2e:fixture",
    "test:e2e:ci": "node --experimental-strip-types scripts/test/run-playwright.ts ci",
    "pretest:e2e:resource": "node --experimental-strip-types scripts/test/prepare-resource-fixtures.ts",
    "test:e2e:resource": "node --experimental-strip-types scripts/test/run-playwright.ts resource",
    "pretest:e2e:deploy": "pnpm prepare:e2e:fixture",
    "test:e2e:deploy": "node --experimental-strip-types scripts/test/run-playwright.ts deploy",
    "quality": "pnpm -s fmt && pnpm -s lint && pnpm -s check && pnpm -s check:test:unit && pnpm -s check:test:e2e && pnpm -s check:scripts && pnpm -s test:ci && pnpm -s check:i18n && pnpm -s circular && pnpm -s knip && pnpm -s knip:production && pnpm -s quality:nose",
    "quality:fix": "pnpm -s fmt:fix && pnpm -s lint:fix && pnpm -s quality",
    "quality:nose": "node --experimental-strip-types scripts/check/nose.ts",
    "verify": "pnpm -s quality && pnpm -s build:ci",
    "verify:full": "pnpm verify && pnpm test:cov && node --experimental-strip-types scripts/test/run-e2e-on-free-port.ts",
    "mut": "stryker run --reporters=progress",
    "mut:fast": "stryker run stryker.conf.fast.json",
    "release:prepare": "node --experimental-strip-types scripts/release/prepare.ts",
    "test:cov": "vitest run --coverage",
    "check:i18n": "node --experimental-strip-types scripts/check/i18n.ts"
  },
  "dependencies": {
    "@piesp/browser-core": "file:packages/core",
    "gifenc": "^1.0.3",
    "mediabunny": "1.59.1",
    "solid-js": "1.9.15",
    "wasm-webp": "^0.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/dom-webcodecs": "^0.1.19",
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "^4.1.11",
    "dpdm": "4.3.0",
    "jsdom": "30.1.1",
    "knip": "^6.39.0",
    "rollup-plugin-visualizer": "7.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "8.3.1",
    "vite-plugin-solid": "2.11.14",
    "vitest": "^4.1.11",
    "wrangler": "^4.145.0"
  }
}
