{
  "name": "wasm-motion-converter",
  "version": "0.1.0",
  "license": "MIT",
  "author": "PiesP",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "volta": {
    "node": "26.4.0",
    "pnpm": "11.2.2"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=\"--no-deprecation\" vite",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "fmt": "biome check --linter-enabled=false .",
    "fmt:fix": "biome check --write --linter-enabled=false .",
    "fmt:check": "pnpm -s fmt",
    "check": "tsc -p tsconfig.json --noEmit",
    "typecheck": "pnpm -s check",
    "knip": "knip --dependencies",
    "circular": "pnpm dlx madge --ts-config tsconfig.json --circular src/**/*.ts",
    "knip:full": "knip --files --exports --dependencies --reporter compact --max-show-issues 50 --no-exit-code",
    "prebuild": "npx tsx scripts/generate-licenses.ts && pnpm -s quality:ci",
    "build": "NODE_OPTIONS=\"--no-deprecation\" vite build && npx tsx scripts/postbuild.ts",
    "postbuild": "npx tsx scripts/postbuild.ts",
    "analyze": "NODE_OPTIONS=\"--no-deprecation\" VITE_ANALYZE_BUNDLE=true vite build && node -e \"console.log('\\\\nBundle analysis generated at dist/stats.html')\"",
    "preview": "NODE_OPTIONS=\"--no-deprecation\" vite preview",
    "clean": "rm -rf dist node_modules/.vite",
    "test": "cd test && pnpm test",
    "test:watch": "cd test && pnpm test:watch",
    "quality": "pnpm -s fmt && pnpm -s lint && pnpm -s check && pnpm -s circular && pnpm -s knip",
    "quality:fix": "pnpm -s fmt:fix && pnpm -s lint:fix && pnpm -s check && pnpm -s circular && pnpm -s knip",
    "quality:ci": "pnpm -s fmt && pnpm -s lint && pnpm -s check && pnpm -s circular",
    "verify": "pnpm -s quality && pnpm -s build",
    "mut": "cd test && npx stryker run ../stryker.conf.json --reporters=progress",
    "mut:fast": "cd test && npx stryker run ../stryker.conf.json --reporters=progress --mutators=boolean,arithmetic,conditional-boundary,equality-operator,negate-conditional,string"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "mediabunny": "^1.50.2",
    "solid-js": "1.9.13",
    "wasm-webp": "^0.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@tailwindcss/vite": "4.3.2",
    "@types/dom-webcodecs": "^0.1.18",
    "@types/node": "26.1.0",
    "esbuild": "0.28.1",
    "knip": "6.23.0",
    "rollup-plugin-visualizer": "7.0.1",
    "tsx": "^4.22.4",
    "typescript": "6.0.3",
    "vite": "8.1.2",
    "vite-plugin-solid": "2.11.12"
  }
}
