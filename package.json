{
  "name": "wasm-motion-converter",
  "version": "0.0.0",
  "license": "MIT",
  "author": "PiesP",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.2.2"
  },
  "volta": {
    "node": "26.2.0",
    "pnpm": "11.2.2"
  },
  "scripts": {
    "dev": "vite",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "fmt": "biome check --linter-enabled=false .",
    "fmt:fix": "biome check --write --linter-enabled=false .",
    "fmt:check": "pnpm -s fmt",
    "check": "tsc -p tsconfig.json --noEmit",
    "typecheck": "pnpm -s check",
    "knip": "knip --dependencies",
    "circular": "pnpm dlx madge --ts-config tsconfig.json --circular src/**/*.ts",
    "knip:full": "knip --files --exports --dependencies --reporter compact --max-show-issues 50 --no-exit-code",
    "prebuild": "pnpm -s quality",
    "build": "vite build",
    "analyze": "VITE_ANALYZE_BUNDLE=true vite build && node -e \"console.log('\\nBundle analysis generated at dist/stats.html')\"",
    "preview": "vite preview",
    "clean": "rm -rf dist node_modules/.vite",
    "test": "cd test && pnpm test",
    "test:watch": "cd test && pnpm test:watch",
    "quality": "pnpm -s fmt && pnpm -s lint && pnpm -s check && pnpm -s circular && pnpm -s knip",
    "quality:fix": "pnpm -s fmt:fix && pnpm -s lint:fix && pnpm -s check && pnpm -s circular && pnpm -s knip",
    "quality:ci": "pnpm -s quality"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "comlink": "4.4.2",
    "solid-js": "1.9.13"
  },
  "cdnDependencies": {
    "@ffmpeg/core-mt": "0.12.10",
    "modern-gif": "2.1.0",
    "mp4box": "0.5.2",
    "web-demuxer": "4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "25.9.1",
    "esbuild": "0.28.0",
    "knip": "6.14.2",
    "modern-gif": "2.1.0",
    "postcss": "8.5.15",
    "rollup-plugin-visualizer": "7.0.1",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "vite-plugin-solid": "2.11.12"
  }
}
