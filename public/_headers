# Root - COEP/COOP required for SharedArrayBuffer
/*
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Opener-Policy: same-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; connect-src 'self' blob:; media-src 'self' blob:; img-src 'self' blob: data:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

# WebM video files - explicit MIME type
/*.webm
  Content-Type: video/webm

# MP4 video files - explicit MIME type
/*.mp4
  Content-Type: video/mp4

# WASM files - explicit MIME type
/*.wasm
  Content-Type: application/wasm

# Static assets - immutable caching (overrides root Cache-Control)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
