{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/core/schema/stryker-schema.json",
  "mutate": [
    "src/utils/**/*.ts",
    "src/stores/**/*.ts",
    "!src/utils/dom-utils.ts",
    "!src/utils/mediabunny-utils.ts",
    "!src/**/*.d.ts"
  ],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": true
  },
  "reporters": ["progress", "clear-text", "json", "html"],
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "inPlace": true,
  "thresholds": {
    "high": 75,
    "low": 70,
    "break": 70
  },
  "concurrency": 2,
  "timeoutMS": 60000,
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayDeclaration",
      "ObjectLiteral",
      "ArrowFunction",
      "BlockStatement",
      "Regex",
      "UnaryOperator",
      "UpdateOperator",
      "OptionalChaining",
      "AssignmentOperator",
      "PrefixDecrementOperator",
      "PrefixIncrementOperator",
      "PostfixDecrementOperator",
      "PostfixIncrementOperator",
      "MethodExpression",
      "NonNullAssertion",
      "CheckedStatement",
      "SwitchCase",
      "WhileStatement",
      "ForStatement"
    ]
  }
}
