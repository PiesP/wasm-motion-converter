+// Frozen pre-optimization pixel traversal from 8fbef739. Keep this independent
+// of the production tile iteration so the differential test catches boundary
+// and moment changes instead of repeating the optimized implementation.
+function referenceMotionSignature(
+  pixels: Uint8Array,
+  width: number,
+  height: number,
+  stride: 3 | 4
+): MotionSignature {
+  const tileColumns = 16;
+  const tileCount = tileColumns * tileColumns;
+  const channels = 3;
+  const sums = new Uint32Array(tileCount * channels);
+  const counts = new Uint32Array(tileCount);
+  const horizontalMoments = new Float64Array(sums.length);
+  const verticalMoments = new Float64Array(sums.length);
+  const minima = new Uint8Array(sums.length);
+  const maxima = new Uint8Array(sums.length);
+  minima.fill(255);
+
+  for (let y = 0; y < height; y++) {
+    const tileRow = Math.min(tileColumns - 1, Math.floor((y * tileColumns) / height));
+    for (let x = 0; x < width; x++) {
+      const tileColumn = Math.min(tileColumns - 1, Math.floor((x * tileColumns) / width));
+      const tile = tileRow * tileColumns + tileColumn;
+      const tileOffset = tile * channels;
+      const localX = x - Math.ceil((tileColumn * width) / tileColumns);
+      const localY = y - Math.ceil((tileRow * height) / tileColumns);
+      const pixelOffset = (y * width + x) * stride;
+      counts[tile]!++;
+      for (let channel = 0; channel < channels; channel++) {
+        const value = pixels[pixelOffset + channel]!;
+        const offset = tileOffset + channel;
+        sums[offset] = sums[offset]! + value;
+        horizontalMoments[offset] = horizontalMoments[offset]! + value * localX;
+        verticalMoments[offset] = verticalMoments[offset]! + value * localY;
+        if (value < minima[offset]!) minima[offset] = value;
+        if (value > maxima[offset]!) maxima[offset] = value;
+      }
+    }
+  }
+
+  const means = new Uint8Array(sums.length);
+  for (let tile = 0; tile < tileCount; tile++) {
+    const count = counts[tile]!;
+    if (count === 0) continue;
+    for (let channel = 0; channel < channels; channel++) {
+      const offset = tile * channels + channel;
+      means[offset] = Math.round(sums[offset]! / count);
+    }
+  }
+  return {
+    width,
+    height,
+    means,
+    colorSums: sums,
+    minima,
+    maxima,
+    counts,
+    horizontalMoments,
+    verticalMoments,
+  };
+}
