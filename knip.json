{
  "$schema": "./node_modules/knip/schema.json",
  "entry": [
    "index.html!",
    "src/services/conversion-worker/worker.ts!",
    "src/services/webp-encoder-worker.ts!",
    "worker/service-worker.ts!",
    "scripts/ci/classify-workflow-changes.ts",
    "scripts/build/qualify-pages-runtime.ts",
    "scripts/check/run-child.test.ts",
    "scripts/release/verify-source.test.ts",
    "validation/windows/profile.ts",
    "test/unit/**/*.test.{ts,tsx}",
    "test/native/**/*.test.ts",
    "test/e2e/**/*.spec.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx,css}!",
    "scripts/**/*.ts",
    "test/**/*.{ts,tsx}",
    "tooling/**/*.ts",
    "worker/**/*.ts",
    "validation/windows/**/*.ts",
    "*.config.ts"
  ],
  "paths": {
    "@": ["src"],
    "@components": ["src/components"],
    "@services": ["src/services"],
    "@utils": ["src/utils"],
    "@stores": ["src/stores"],
    "@hooks": ["src/hooks"],
    "@t": ["src/types"],
    "@i18n": ["src/i18n"]
  },
  "ignoreBinaries": ["ffmpeg", "ffprobe"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["@types/dom-webcodecs"],
  "node": false
}
