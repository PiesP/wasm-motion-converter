{
  "$schema": "./node_modules/knip/schema.json",
  "entry": ["index.html"],
  "project": ["src/**/*.{ts,tsx}"],
  "paths": {
    "@": ["src"],
    "@components": ["src/components"],
    "@services": ["src/services"],
    "@utils": ["src/utils"],
    "@stores": ["src/stores"],
    "@hooks": ["src/hooks"],
    "@t": ["src/types"]
  },
  "ignore": ["**/*.d.ts"],
  "ignoreBinaries": ["sha256sum"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["@types/dom-webcodecs"]
}
