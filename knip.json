{
  "$schema": "./node_modules/knip/schema.json",
  "entry": ["index.html"],
  "project": ["src/**/*.{ts,tsx}"],
  "paths": {
    "@": ["src"],
    "@components": ["src/components"],
    "@services": ["src/services"],
    "@utils": ["src/utils"],
    "@stores": ["src/stores"],
    "@hooks": ["src/hooks"],
    "@t": ["src/types"]
  },
  "ignore": [
    "dist/**",
    "tmp/**",
    "docs/**",
    ".github/**",
    "**/*.test.{ts,tsx}",
    "**/*.spec.{ts,tsx}",
    "**/*.d.ts"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["@types/dom-webcodecs", "gifenc", "wasm-webp"]
}
