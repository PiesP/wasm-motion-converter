{
  "$schema": "./node_modules/knip/schema.json",
  "entry": ["index.html"],
  "project": ["src/**/*.{ts,tsx}"],
  "paths": {
    "@": ["src"],
    "@components": ["src/components"],
    "@services": ["src/services"],
    "@utils": ["src/utils"],
    "@stores": ["src/stores"],
    "@hooks": ["src/hooks"],
    "@t": ["src/types"],
    "@i18n": ["src/i18n"]
  },
  "ignore": ["**/*.d.ts"],
  "ignoreBinaries": ["ffmpeg"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "@axe-core/playwright",
    "@types/dom-webcodecs",
    "@tailwindcss/vite",
    "wrangler"
  ]
}
