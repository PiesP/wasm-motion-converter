{
  "$schema": "./node_modules/knip/schema.json",
  "entry": [
    "index.html!",
    "src/index.tsx!",
    "src/services/conversion-worker/worker.ts!",
    "src/services/webp-encoder-worker.ts!",
    "test/unit/**/*.test.{ts,tsx}",
    "test/e2e/**/*.spec.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}!",
    "scripts/**/*.ts",
    "test/**/*.{ts,tsx}",
    "tooling/**/*.ts",
    "*.config.ts"
  ],
  "paths": {
    "@": ["src"],
    "@components": ["src/components"],
    "@services": ["src/services"],
    "@utils": ["src/utils"],
    "@stores": ["src/stores"],
    "@hooks": ["src/hooks"],
    "@t": ["src/types"],
    "@i18n": ["src/i18n"]
  },
  "ignore": ["**/*.d.ts", "test/e2e/coverage-gap-analysis.ts"],
  "ignoreBinaries": ["ffmpeg"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "@axe-core/playwright",
    "@types/dom-webcodecs",
    "@tailwindcss/vite",
    "wrangler"
  ]
}
