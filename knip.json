{
  "$schema": "./node_modules/knip/schema.json",
  "entry": [
    "index.html",
    "public/service-worker.ts",
    "public/sw-register.ts",
    "src/workers/**/*.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "public/*.ts"],
  "paths": {
    "@": ["src"],
    "@components": ["src/components"],
    "@services": ["src/services"],
    "@utils": ["src/utils"],
    "@stores": ["src/stores"],
    "@hooks": ["src/hooks"],
    "@t": ["src/types"]
  },
  "ignore": [
    "dist/**",
    "tmp/**",
    "docs/**",
    ".vite-sw-temp/**",
    ".github/**",
    "**/*.test.{ts,tsx}",
    "**/*.spec.{ts,tsx}",
    "**/*.d.ts"
  ],
  "ignoreExportsUsedInFile": true
}
