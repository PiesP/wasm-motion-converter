* text=auto
*.sh text eol=lf
.githooks/* text eol=lf

# JavaScript/TypeScript
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf

# Config/Data
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf

# The demux oracle records the exact selected patch bytes.
patches/mediabunny@*.patch text eol=lf
# Preserve exact historical or recovered patch context.
patches/mediabunny@1.62.1.patch -whitespace
patches/mediabunny@1.66.2.patch -whitespace

# Source-bound GIF scalar WASM inputs and supplemental notice
/LICENSE text eol=lf
crates/gif-scalar-quantizer/src/*.rs text eol=lf
crates/gif-scalar-quantizer/Cargo.lock text eol=lf
scripts/build/gifenc-pnn-NOTICES.txt text eol=lf
# Upstream notices are kept byte-for-byte; their hashes are verified separately.
scripts/build/gifenc-LICENSE.txt text eol=lf -whitespace
scripts/build/heroicons-*-LICENSE.txt text eol=lf
public/notices/rust-1.100.0.html text eol=lf -whitespace linguist-vendored
crates/gif-scalar-quantizer/LICENSE.pnn text eol=lf
crates/owned-vp8/LICENSE.* text eol=lf
crates/owned-vp8/PATENTS.* text eol=lf
public/notices/*.txt text eol=lf
# Recipient copies are identified by their as-delivered byte hashes.
public/notices/historical-gif/original/*.md -text -whitespace linguist-vendored

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.wasm binary
*.woff2 binary
