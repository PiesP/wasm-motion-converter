#!/usr/bin/env bash
set -euo pipefail

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/master|refs/heads/main)
      echo "Direct default-branch pushes are blocked. Push a work branch and use a protected pull request." >&2
      exit 1
      ;;
  esac
done
