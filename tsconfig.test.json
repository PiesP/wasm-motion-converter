{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node",
      "vite/client",
      "vitest/globals"
    ],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/**/*.d.ts",
    "test/unit"
  ],
  "exclude": [
    "test/e2e",
    "test/node_modules"
  ]
}
