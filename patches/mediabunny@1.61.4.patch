index 0000000..b994275
--- /dev/null
+++ b/dist/modules/src/isobmff/sample-budget.js
@@ -0,0 +1,85 @@
+// Input-wide MP4 sample/index accounting. Costs include array spare capacity,
+// object/reference overhead and sort scratch; they are policy units, not measured heap bytes.
+export class IsobmffSampleBudget {
+    constructor(input) {
+        this.input = input;
+        this.retainedBytes = 0;
+        this.uniqueFragmentBytes = 0;
+        this.currentFragmentBytes = 0;
+        this.lastFragmentBytes = 0;
+        this.totalSamples = 0;
+        this.error = null;
+        this.tracks = new Map();
+        this.fragments = new Map();
+    }
+    fail(message) {
+        this.error ??= new RangeError('ISOBMFF sample metadata: ' + message);
+        throw this.error;
+    }
+    check() {
+        if (this.error)
+            throw this.error;
+    }
+    count(count) {
+        this.check();
+        if (!Number.isSafeInteger(count) || count < 0 || count > this.input._maxIsobmffSamples) {
+            this.fail('sample count exceeds the configured safety limit.');
+        }
+    }
+    encoded(count, bytesPerEntry, remainingBytes) {
+        this.count(count);
+        const bytes = count * bytesPerEntry;
+        if (!Number.isSafeInteger(bytes) || bytes > remainingBytes) {
+            this.fail('truncated or invalid sample table.');
+        }
+    }
+    reserve(count, cost, fragment = false) {
+        this.count(count);
+        const bytes = count * cost;
+        const limit = this.input._maxIsobmffMetadataBytes;
+        if (!Number.isSafeInteger(bytes)
+            || bytes > limit - this.retainedBytes - this.currentFragmentBytes - this.lastFragmentBytes
+            || (!fragment && bytes > limit - this.retainedBytes - this.uniqueFragmentBytes)) {
+            this.fail('allocation exceeds the configured memory limit.');
+        }
+        if (fragment)
+            this.currentFragmentBytes += bytes;
+        else
+            this.retainedBytes += bytes;
+    }
+    track(track, table, addedFragments = 0) {
+        const previous = this.tracks.get(track) ?? { table: 0, fragments: 0 };
+        const nextTable = Math.max(previous.table, table);
+        const fragments = previous.fragments + addedFragments;
+        const added = nextTable - previous.table + addedFragments;
+        this.count(nextTable + fragments);
+        this.count(this.totalSamples + added);
+        if (!this.tracks.has(track))
+            this.reserve(1, 128);
+        this.totalSamples += added;
+        this.tracks.set(track, { table: nextTable, fragments });
+    }
+    fragment(offset, track, count, runTotal) {
+        this.count(runTotal);
+        let counts = this.fragments.get(offset);
+        if (!counts) {
+            this.reserve(1, 128);
+            counts = new Map();
+            this.fragments.set(offset, counts);
+        }
+        const previous = counts.get(track) ?? 0;
+        const added = Math.max(0, runTotal - previous);
+        this.track(track, 0, added);
+        if (!counts.has(track))
+            this.reserve(1, 96);
+        // A fragment sample plus mapped presentation entry/sort references costs 304 units.
+        const bytes = added * 304;
+        if (!Number.isSafeInteger(bytes)
+            || bytes > this.input._maxIsobmffMetadataBytes - this.retainedBytes - this.uniqueFragmentBytes) {
+            this.fail('cumulative fragment work exceeds the configured memory limit.');
+        }
+        this.uniqueFragmentBytes += bytes;
+        counts.set(track, Math.max(previous, runTotal));
+        this.reserve(count, 192, true);
+    }
+}
